{
  "name": "sgb-local-server",
  "version": "1.0.0",
  "description": "Small local server for STYLE GLAMOUR BEATS to store users in users.json",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently --no-kill-others \"node server.js\" \"wait-on http-get://127.0.0.1:3000/style-advisor.html && cmd /c start http://127.0.0.1:3000/style-advisor.html\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.5.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.6.9"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
